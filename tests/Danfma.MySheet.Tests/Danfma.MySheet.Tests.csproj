<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>

    <!-- Phase 3 Task 1 landed the table-registry acceptance pins (TableRegistryTests, the
         `Tables.Count == 0` backward-compatibility guards and RedefiningATable_ForcesAFullRecompute)
         behind MYSHEET_TABLES. Danfma.MySheet.Table, Workbook.Tables and Workbook.DefineTable do not
         exist yet, and a missing type is a BUILD failure, not a usable RED test: it would take the whole
         1582-test suite down instead of failing the pins. The task that lands the model (Phase 3 items
         1-14) must uncomment the line below IN THE SAME COMMIT — those pins are its acceptance criteria.
         This is the ONLY switch; grep MYSHEET_TABLES for everything it turns on. -->
    <!-- <DefineConstants>$(DefineConstants);MYSHEET_TABLES</DefineConstants> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.*" />
    <!-- Test-only oracle: a .NET port of Excel's financial functions, used to cross-check
         our implementations against Excel's results. NOT referenced by the published library. -->
    <PackageReference Include="ExcelFinancialFunctions" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Danfma.MySheet\Danfma.MySheet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frozen binary fixtures (e.g. the pre-2.0 MemoryPack compatibility workbook). -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
